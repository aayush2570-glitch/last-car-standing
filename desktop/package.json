{
  "name": "last-car-standing-desktop",
  "version": "1.0.0",
  "description": "Last Car Standing",
  "author": "aayush2570-glitch",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.aayush2570.lastcarstanding",
    "productName": "Last Car Standing",
    "files": [
      "main.js",
      "build/icon.ico",
      "game/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LastCarStanding-${version}-${arch}-portable.exe"
    }
  }
}
